  "item": [
    {
      "name": "1. OData v4 — Service & Metadata",
      "item": [
        {
          "name": "Get OData Service Document",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata",
              "host": ["{{baseUrl}}"],
              "path": ["odata"]
            },
            "description": "Returns the OData v4 Service Document listing all exposed EntitySets (Employees, Departments, CostCenters, Locations)."
          }
        },
        {
          "name": "Get OData CSDL $metadata (XML)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/$metadata",
              "host": ["{{baseUrl}}"],
              "path": ["odata", "$metadata"]
            },
            "description": "Returns the OData v4 CSDL XML schema used by IDM OData connectors to discover entities, keys, properties, and navigation properties."
          }
        }
      ]
    },
    {
      "name": "2. OData v4 — Employees (Queries & Full CRUD)",
      "item": [
        {
          "name": "List Employees ($top, $skip, $count)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/Employees?$top=25&$skip=0&$count=true",
              "host": ["{{baseUrl}}"],
              "path": ["odata", "Employees"],
              "query": [
                {
                  "key": "$top",
                  "value": "25"
                },
                {
                  "key": "$skip",
                  "value": "0"
                },
                {
                  "key": "$count",
                  "value": "true"
                }
              ]
            },
            "description": "Paginated OData query returning Employees and total record count (`@odata.count`). Maximum `$top` is 5000."
          }
        },
        {
          "name": "Filter Active Employees ($filter, $select, $orderby)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/Employees?$filter=EmploymentStatus eq 'Active'&$select=Id,Username,PersonnelNumber,FirstName,LastName,Email,JobTitle,EmploymentStatus,HireDate,DepartmentStructuredName&$orderby=LastName asc&$top=25&$count=true",
              "host": ["{{baseUrl}}"],
              "path": ["odata", "Employees"],
              "query": [
                {
                  "key": "$filter",
                  "value": "EmploymentStatus eq 'Active'"
                },
                {
                  "key": "$select",
                  "value": "Id,Username,PersonnelNumber,FirstName,LastName,Email,JobTitle,EmploymentStatus,HireDate,DepartmentStructuredName"
                },
                {
                  "key": "$orderby",
                  "value": "LastName asc"
                },
                {
                  "key": "$top",
                  "value": "25"
                },
                {
                  "key": "$count",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Filter Terminated Employees with Expanded Relations ($expand)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/Employees?$filter=EmploymentStatus eq 'Terminated'&$expand=Department,CostCenter,Location&$top=20&$count=true",
              "host": ["{{baseUrl}}"],
              "path": ["odata", "Employees"],
              "query": [
                {
                  "key": "$filter",
                  "value": "EmploymentStatus eq 'Terminated'"
                },
                {
                  "key": "$expand",
                  "value": "Department,CostCenter,Location"
                },
                {
                  "key": "$top",
                  "value": "20"
                },
                {
                  "key": "$count",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "Delta Sync — Employees Modified Since Timestamp ($filter UpdatedAt)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/Employees?$filter=UpdatedAt gt 2026-01-01T00:00:00Z&$orderby=UpdatedAt desc&$top=50",
              "host": ["{{baseUrl}}"],
              "path": ["odata", "Employees"],
              "query": [
                {
                  "key": "$filter",
                  "value": "UpdatedAt gt 2026-01-01T00:00:00Z"
                },
                {
                  "key": "$orderby",
                  "value": "UpdatedAt desc"
                },
                {
                  "key": "$top",
                  "value": "50"
                }
              ]
            },
            "description": "Useful for IDM delta synchronization: fetches employees modified after a given UTC timestamp."
          }
        },
        {
          "name": "Get Employee by Key with $expand",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/odata/Employees({{employeeId}})?$expand=Department,CostCenter,Location",
