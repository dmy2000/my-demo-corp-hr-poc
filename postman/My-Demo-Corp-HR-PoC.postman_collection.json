              "path": ["odata", "Employees({{employeeId}})"],
              "query": [
                {
                  "key": "$expand",
                  "value": "Department,CostCenter,Location"
                }
              ]
            }
          }
        },
        {
          "name": "Create Employee (POST)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
