              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Username\": \"POSTMAN1\",\n  \"PersonnelNumber\": \"10099\",\n  \"FirstName\": \"Alex\",\n  \"LastName\": \"Mercer\",\n  \"Initials\": \"AM\",\n  \"Email\": \"alex.mercer@mydemocorp.com\",\n  \"JobTitle\": \"Identity & Access Engineer\",\n  \"EmploymentStatus\": \"Active\",\n  \"HireDate\": \"2026-02-01\",\n  \"Phone\": \"+49-30-5550-199\",\n  \"City\": \"Berlin\",\n  \"Street\": \"Friedrichstrasse 123\",\n  \"ZipCode\": \"10117\",\n  \"DepartmentStructuredName\": \"My Demo Corp\\\\Technology & Engineering\\\\IT Infrastructure & Security\",\n  \"CostCenterStructuredName\": \"20\\\\20200\",\n  \"LocationStructuredName\": \"DE - Berlin - Friedrichstrasse 123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/odata/Employees",
              "host": ["{{baseUrl}}"],
              "path": ["odata", "Employees"]
